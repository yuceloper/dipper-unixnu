diff --git a/DarwinBootPkg/Driver/Entry.S b/DarwinBootPkg/Driver/Entry.S
index 890d4df..a48cc06 100644
--- a/DarwinBootPkg/Driver/Entry.S
+++ b/DarwinBootPkg/Driver/Entry.S
@@ -9,6 +9,8 @@ ASM_FUNC(DarwinCurrentEl)
 // PA (0 for none), x5=its size in bytes. EL1 only.
 ASM_FUNC(DarwinEnter)
   msr daifset, #15
+  mov x12, x4
+  mov x13, x5
   // Breadcrumb: a green bar (BGRA 0xFF00FF00) over the top 1/16 of the frame
   // buffer shows that this code ran, whatever the kernel does afterwards.
   cbz x4, 2f
@@ -40,6 +42,21 @@ ASM_FUNC(DarwinEnter)
   ic iallu
   dsb sy
   isb
+
+  // Diagnostic framebuffer marker; preserve boot arguments x0-x3.
+  cbz x12, .Lcache_done_done
+  lsr x9, x13, #4
+  bic x9, x9, #7
+  cbz x9, .Lcache_done_done
+  mov w10, #0x00ff
+  movk w10, #0xffff, lsl #16
+  mov x11, x12
+.Lcache_done_loop:
+  stp w10, w10, [x11], #8
+  subs x9, x9, #8
+  b.hi .Lcache_done_loop
+  dsb sy
+.Lcache_done_done:
   mrs x4, sctlr_el1
   bic x4, x4, #1
   bic x4, x4, #4
@@ -49,4 +66,19 @@ ASM_FUNC(DarwinEnter)
   tlbi vmalle1
   dsb sy
   isb
+
+  // Diagnostic framebuffer marker; preserve boot arguments x0-x3.
+  cbz x12, .Lmmu_off_done
+  lsr x9, x13, #4
+  bic x9, x9, #7
+  cbz x9, .Lmmu_off_done
+  mov w10, #0xffff
+  movk w10, #0xff00, lsl #16
+  mov x11, x12
+.Lmmu_off_loop:
+  stp w10, w10, [x11], #8
+  subs x9, x9, #8
+  b.hi .Lmmu_off_loop
+  dsb sy
+.Lmmu_off_done:
   br x1
