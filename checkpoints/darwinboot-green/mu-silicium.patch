diff --git a/Silicon/Silicium/SiliciumPkg/Sec/AArch64/Helper.S b/Silicon/Silicium/SiliciumPkg/Sec/AArch64/Helper.S
index 053012de..e8df3ac9 100644
--- a/Silicon/Silicium/SiliciumPkg/Sec/AArch64/Helper.S
+++ b/Silicon/Silicium/SiliciumPkg/Sec/AArch64/Helper.S
@@ -44,4 +44,63 @@ ASM_FUNC (SetupExceptionLevel2)
 
   ret
 
+//
+// Cleans and invalidates every data cache level up to the Level of Coherence by set/way (the standard sequence: CLIDR_EL1 levels,
+// CSSELR_EL1 to select, CCSIDR_EL1 geometry, DC CISW). The previous stage ran with its caches on and leaves lines behind that the UEFI,
+// running with the MMU and caches off until ArmConfigureMmu, never wrote: once the caches are on, those stale lines would hide the
+// DRAM contents (HOB tables, heap) written in between, or be written back over them. Cleaning keeps what the previous stage wrote.
+// Corrupts x0-x11; callable with the MMU on or off.
+//
+ASM_FUNC (SecCleanInvalidateDataCacheAll)
+  dmb   sy
+  mrs   x0, clidr_el1
+  and   x3, x0, #0x7000000          // LoC, shifted
+  lsr   x3, x3, #23                 // LoC * 2
+  cbz   x3, 5f
+  mrs   x1, id_aa64mmfr2_el1
+  ubfx  x8, x1, #20, #4             // CCIDX
+  mov   x10, #0                     // level * 2
+1:
+  add   x2, x10, x10, lsr #1
+  lsr   x1, x0, x2
+  and   x1, x1, #7                  // cache type of this level
+  cmp   x1, #2
+  b.lt  4f                          // no data cache here
+  msr   csselr_el1, x10
+  isb
+  mrs   x1, ccsidr_el1
+  and   x2, x1, #7
+  add   x2, x2, #4                  // log2 (line bytes)
+  cbz   x8, 6f
+  ubfx  x4, x1, #3, #21             // CCIDX: associativity - 1
+  ubfx  x7, x1, #32, #24            // CCIDX: sets - 1
+  b     7f
+6:
+  ubfx  x4, x1, #3, #10             // associativity - 1
+  ubfx  x7, x1, #13, #15            // sets - 1
+7:
+  clz   w5, w4                      // bit position of the way field
+2:
+  mov   x9, x4
+3:
+  lsl   x6, x9, x5
+  orr   x11, x10, x6                // way and level
+  lsl   x6, x7, x2
+  orr   x11, x11, x6                // set
+  dc    cisw, x11
+  subs  x9, x9, #1
+  b.ge  3b
+  subs  x7, x7, #1
+  b.ge  2b
+4:
+  add   x10, x10, #2
+  cmp   x3, x10
+  b.gt  1b
+5:
+  mov   x10, #0
+  msr   csselr_el1, x10
+  dsb   sy
+  isb
+  ret
+
 ASM_FUNCTION_REMOVE_IF_UNREFERENCED
diff --git a/Silicon/Silicium/SiliciumPkg/Sec/AArch64/ModuleEntryPoint.S b/Silicon/Silicium/SiliciumPkg/Sec/AArch64/ModuleEntryPoint.S
index 0c05ffa3..e718752b 100644
--- a/Silicon/Silicium/SiliciumPkg/Sec/AArch64/ModuleEntryPoint.S
+++ b/Silicon/Silicium/SiliciumPkg/Sec/AArch64/ModuleEntryPoint.S
@@ -13,6 +13,22 @@
 .set CTRL_SPAN_BIT, BIT23
 
 ASM_FUNC (_ModuleEntryPoint)
+  // Before the first store of this stage: clean and invalidate the data caches the previous stage filled (x0 is kept in x20).
+  mov   x20, x0
+  mov   x21, x1
+  mov   x22, x2
+  bl    ASM_PFX (SecCleanInvalidateDataCacheAll)
+  mov   x0, x20
+
+  // Keep x0 for the platform. It is the address of the DT a Linux-style boot
+  // loader hands over. The slot is in this section, which is in RAM here.
+  adr   x1, ASM_PFX (gSecEntryArg0)
+  str   x0, [x1]
+  adr   x1, ASM_PFX (gSecPayloadAddress)
+  str   x21, [x1]
+  adr   x1, ASM_PFX (gSecPayloadSize)
+  str   x22, [x1]
+
   // Do Platform Specific Initialization
   bl    ASM_PFX (PlatformAssemblyInitialize)
 
@@ -61,3 +77,17 @@ ASM_PFX (MainEntryPoint):
 
   // Do Infinite Spin
   b     .
+
+  // First argument of the previous stage, written once at entry
+  .align 3
+  .global ASM_PFX (gSecEntryArg0)
+ASM_PFX (gSecEntryArg0):
+  .quad 0
+
+  .align 3
+  .global ASM_PFX (gSecPayloadAddress)
+ASM_PFX (gSecPayloadAddress):
+  .quad 0
+  .global ASM_PFX (gSecPayloadSize)
+ASM_PFX (gSecPayloadSize):
+  .quad 0
diff --git a/Silicon/Silicium/SiliciumPkg/Sec/Sec.c b/Silicon/Silicium/SiliciumPkg/Sec/Sec.c
index 8d586b35..5d47245a 100644
--- a/Silicon/Silicium/SiliciumPkg/Sec/Sec.c
+++ b/Silicon/Silicium/SiliciumPkg/Sec/Sec.c
@@ -18,6 +18,16 @@
 
 #include "Sec.h"
 
+// First argument (x0) of the previous stage, saved by ModuleEntryPoint.S
+extern UINT64  gSecEntryArg0;
+extern UINT64  gSecPayloadAddress;
+extern UINT64  gSecPayloadSize;
+
+VOID
+SecCleanInvalidateDataCacheAll (
+  VOID
+  );
+
 #ifndef MDEPKG_NDEBUG
 STATIC
 VOID
@@ -118,6 +128,19 @@ SecMain (VOID)
     return;
   }
 
+  // Pass on what the previous stage handed over in x0 (a DT address for a
+  // Linux-style boot loader), so a DXE driver can use it.
+  {
+    UINT64  EntryArg = gSecEntryArg0;
+
+    BuildGuidDataHob (&gSiliciumEntryArgHobGuid, &EntryArg, sizeof (EntryArg));
+  }
+  if (gSecPayloadSize != 0) {
+    UINT64  Payload[2] = { gSecPayloadAddress, gSecPayloadSize };
+
+    BuildGuidDataHob (&gSiliciumAppendedPayloadHobGuid, Payload, sizeof (Payload));
+  }
+
   // Build CPU HOB
   BuildCpuHob (ArmGetPhysicalAddressBits (), PcdGet8 (PcdPrePiCpuIoSize));
 
@@ -150,6 +173,10 @@ SecMain (VOID)
 VOID
 SecEntry (VOID)
 {
+  // The previous stage ran with its caches on. Clean and invalidate them before anything else: the UEFI writes its HOB tables and heap with
+  // the MMU and caches off, and lines the previous stage left would hide those writes (or be written back over them) once the caches are on.
+  SecCleanInvalidateDataCacheAll ();
+
   // Disable Data Cache
   ArmDisableDataCache ();
 
