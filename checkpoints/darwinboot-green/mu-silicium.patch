diff --git a/BootShim/BootShim.S b/BootShim/BootShim.S
index 4d208553..a0aa1fff 100644
--- a/BootShim/BootShim.S
+++ b/BootShim/BootShim.S
@@ -7,7 +7,7 @@ _StackBase:
   .quad FD_BASE         /* Text Offset */
 
 _StackSize:
-  .quad FD_SIZE         /* Image Size */
+  .quad FD_SIZE + (_Payload - _Head) + APPENDED_PAYLOAD_SIZE /* Complete image */
   .quad 0               /* Flags */
   .quad 0               /* Reserved */
   .quad 0               /* Reserved */
@@ -30,11 +30,33 @@ _CopyLoop:
   b.ne  _CopyLoop
   ldr   x5, =FD_BASE
 
+  /* Publish the copied instructions before executing them. */
+  dsb   sy
+  mrs   x9, ctr_el0
+  ubfx  x9, x9, #16, #4
+  mov   x10, #4
+  lsl   x9, x10, x9
+  sub   x10, x9, #1
+  bic   x8, x5, x10
+  ldr   x7, =FD_SIZE
+  add   x7, x5, x7
+
+_CleanLoop:
+  dc    cvac, x8
+  add   x8, x8, x9
+  cmp   x8, x7
+  b.lo  _CleanLoop
+  dsb   sy
+  ic    iallu
+  dsb   sy
+  isb
+
 _Entry:
   br    x5
 
 _Dead:
   b     _Dead
+.ltorg
 
 .text
 .align 4
